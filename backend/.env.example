# Database — leave blank for SQLite fallback or set PostgreSQL URL
DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_financial
USE_SQLITE_FALLBACK=true

# JWT — generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-secret-key-in-production-use-openssl-rand-hex-32

# Redis (Celery + cache)
REDIS_URL=redis://localhost:6379/0

# Ollama / llama.cpp endpoint
OLLAMA_BASE_URL=http://localhost:11434

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000
