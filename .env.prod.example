# ── Samvaad PROD env template ──────────────────────────────────────
# Copy to /etc/samvaad/.env.prod (chmod 600) on the VM. Never commit real secrets.
# Generate secrets with: openssl rand -hex 32

# Postgres (must match POSTGRES_* in docker-compose.prod.yml)
DATABASE_URL=postgresql://rag_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/rag_financial
USE_SQLITE_FALLBACK=false
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rag_financial

# Auth
JWT_SECRET_KEY=CHANGE_ME_64_HEX_CHARS_MIN_32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# LLM (prod internal service name — no host.docker.internal)
LLM_PROVIDER=llama.cpp
LLAMACPP_BASE_URL=http://llm:8000
LLAMACPP_MODEL=gemma-4-E4B-it-Q5_K_M
LLAMACPP_MODEL_FILE=gemma-4-E4B-it-Q5_K_M.gguf
LLAMACPP_CTX_SIZE=8192
LLAMACPP_N_GPU_LAYERS=99
LLAMACPP_THREADS=8
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# TLS domain (nginx cert lives at /etc/letsencrypt/live/<domain>/)
TLS_DOMAIN=CHANGE_ME_YOUR_DOMAIN

# CORS — your https origin (no localhost in prod)
CORS_ORIGINS=https://CHANGE_ME_YOUR_DOMAIN

# Frontend calls same-origin /api via nginx proxy — no VITE_API_URL needed.

# Nightly pg_dump interval in seconds (default 86400 = 24h)
BACKUP_INTERVAL_SECS=86400
